{
  "name": "@dsh-external/dsh-side-session",
  "version": "0.3.2",
  "private": true,
  "description": "DSH 临时会话：独立悬浮窗，自动导入当前主对话上下文，发起不污染主会话的临时追问",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luoyur0/dsh-side-session.git"
  },
  "homepage": "https://github.com/Luoyur0/dsh-side-session#readme",
  "bugs": {
    "url": "https://github.com/Luoyur0/dsh-side-session/issues"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
